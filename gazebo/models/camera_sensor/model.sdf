<?xml version="1.0" ?>
<sdf version="1.9">
    <model name="camera_sensor">
        <static>true</static>
        <link name="cam_body">
            <sensor name="cam_sens" type="camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>camera/image</topic>
            </sensor>
        </link>
    </model>
</sdf>
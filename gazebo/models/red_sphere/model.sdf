<?xml version="1.0" ?>
<sdf version="1.9">
    <model name="red_sphere">
        <link name="linker">
            <pose>0 0 1.0 0 0 0</pose>
            <visual name="vis">
                <geometry>
                    <sphere>
                        <radius>0.75</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>1.0 0 0 1</ambient>
                    <diffuse>1.0 0 0 1</diffuse>
                    <specular>1.0 0 0 1</specular>
                </material>
            </visual>
            <collision name="col">
                <geometry>
                    <sphere>
                        <radius>0.75</radius>
                    </sphere>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>
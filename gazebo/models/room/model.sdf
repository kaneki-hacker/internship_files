<?xml version="1.0"  ?>
<sdf version="1.9">
    <model name="room">
        <static>true</static>

        <link name="center"> </link>

        <link name="wall_one">
            <pose relative_to="center">0 2.0 1.5 0 0 0</pose>
            <visual name="vis_one">
                <geometry>
                    <box>
                        <size>4.0 0.5 3.0</size>
                    </box>
                </geometry>
            </visual>
        </link>

        <link name="wall_two">
            <pose relative_to="center">0 -2.0 1.5 0 0 0</pose>
            <visual name="vis_two">
                <geometry>
                    <box>
                        <size>4.0 0.5 3.0</size>
                    </box>
                </geometry>
            </visual>
        </link>

        <link name="wall_three">
            <pose relative_to="center">2.0 0.0 1.5 0 0 0</pose>
            <visual name="Vis">
                <geometry>
                    <box>
                        <size>0.5 4.5 3.0</size>
                    </box>
                </geometry>
            </visual>
        </link>

        <link name="door_wall_p1">
            <pose relative_to="center">-2.0 1.5 1.5 0 0 0</pose>
            <visual name="Vis">
                <geometry>
                    <box>
                        <size>0.3 1.5 3.0</size>
                    </box>
                </geometry>
            </visual>
        </link>

        <link name="door_wall_p2">
            <pose relative_to="center">-2.0 -1.5 1.5 0 0 0</pose>
            <visual name="Vis">
                <geometry>
                    <box>
                        <size>0.3 1.5 3.0</size>
                    </box>
                </geometry>
            </visual>
        </link>

        <include>
            <uri>model://red_sphere</uri>
            <name>Red_sphere</name>
        </include>

    </model>
</sdf>